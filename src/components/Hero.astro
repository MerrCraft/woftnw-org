---
import { SITE_TITLE } from '../consts';
import { Picture } from 'astro:assets';
import wordmark from '../assets/wordmark.png';
import showcase from '../assets/showcase.mp4';
import Container from './Container.astro';
import Tagline from './Tagline.astro';
import Button from './Button.astro';
import Center from './Center.astro';
import Stack from './Stack.astro';
import JoinHelpText from './JoinHelpText.astro';
---

<div>
	<div class="banner">
		<div>
			<video autoplay muted loop src={showcase} />
		</div>
		<Picture priority src={wordmark} formats={['avif', 'webp']} alt="Wings of Fire: The New World" />
	</div>
	<div class="tagline">
		<Container>
			<Stack>
				<Tagline><b>Wings of Fire: The New World</b> is a community-driven Minecraft: Java Edition sever based on the <i>Wings of Fire</i> series of novels.</Tagline>
				<Center><Button href="https://discord.woftnw.org">Join the Discord</Button></Center>
				<Center><JoinHelpText /></Center>
			</Stack>
		</Container>
	</div>
</div>
<style>
	.banner {
		display: grid;
		align-items: center;
	}
	.banner > * {
		grid-column: 1;
		grid-row: 1;
		height: 40vw;
		width: 100%;
		z-index: -1;
		display: grid;
		align-content: center;
	}
	video {
		width: 100%;
	}
	.tagline {
		padding-top: min(2.5rem, 3vw);
		padding-bottom: min(2.5rem, 3vw);
		background-image: linear-gradient(178deg, rgb(210, 166, 47) 0%, rgb(209, 66, 46) 100%);
	}
</style>
